<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Required for google_sign_in 7.x on Android (Credential Manager).

      Use the OAuth 2.0 Client ID of type "Web application" from Google Cloud Console
      (same API project as your Android OAuth client). Replace the placeholder below.

      Alternative: omit this string resource and pass GOOGLE_SERVER_CLIENT_ID using the
      Flutter dart-define flag (see lib/constants/google_sign_in_config.dart).
    -->
    <string name="default_web_client_id">YOUR_WEB_CLIENT_ID.apps.googleusercontent.com</string>

    <!--
      Meta Facebook Login: MUST be numeric App ID from developer.facebook.com (Settings, Basic).
      Non numeric placeholders break Facebook SDK init so flutter_facebook_auth never registers
      and Dart shows MissingPluginException. Replace both values with your real app before release.
    -->
    <string name="facebook_app_id">123456789012345</string>
    <string name="facebook_client_token">abcdef0123456789abcdef0123456789</string>
</resources>
